# LLM Provider
LLM_PROVIDER=gemini                  # or: openai
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here  # optional fallback

# Agent config
MIN_FIT_SCORE=80                     # Jobs below this are auto-discarded
MAX_APPS_PER_DAY=20                  # Safety rate limit
DISCOVERY_SCHEDULE=09:00             # Daily run time (24hr, user's local tz)
LISTINGS_MAX_AGE_DAYS=14             # Skip listings older than this

# Browser
BROWSER_HEADLESS=false               # true = run invisible, false = watch it work
BROWSER_PROFILE_DIR=./browser_profile  # persistent session cookie storage

# DB
DATABASE_URL=sqlite:///./openapply.db
